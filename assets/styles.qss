/* Project Sumpay - flat high-contrast medical dashboard.
   Color tokens are substituted at runtime from gui/theme.py. */

QMainWindow, QWidget {
    background-color: @BG_PRIMARY@;
    color: @TEXT_PRIMARY@;
    font-family: @FONT_FAMILY@;
    font-size: @FONT_SIZE_BASE@px;
}

QLabel {
    color: @TEXT_PRIMARY@;
    background: transparent;
}

QLabel#headerTitle {
    color: @ACCENT@;
    font-size: @FONT_SIZE_HEADER@px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 14px 20px 10px 20px;
}

QLabel#headerSubtitle {
    color: @TEXT_SECONDARY@;
    font-size: @FONT_SIZE_BASE@px;
    padding: 0 20px 14px 20px;
    letter-spacing: 1px;
}

QFrame#headerBar {
    background-color: @BG_SECONDARY@;
    border-bottom: 2px solid @ACCENT@;
}

QFrame#panel {
    background-color: @BG_SECONDARY@;
    border: 1px solid @BORDER@;
}

QLabel#panelTitle {
    color: @ACCENT@;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 10px 14px;
    border-bottom: 1px solid @BORDER@;
    background-color: @BG_PANEL@;
}

QLabel#videoCanvas, QVideoWidget {
    background-color: #000000;
    border: 1px solid @BORDER@;
}

QListWidget {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT_PRIMARY@;
    font-size: @FONT_SIZE_TRANSCRIPT@px;
    padding: 8px;
}

QListWidget::item {
    padding: 10px 6px;
    border-bottom: 1px solid @BORDER@;
}

QListWidget::item:selected {
    background-color: @ACCENT_DIM@;
    color: @BG_PRIMARY@;
}

QLabel#liveCaption {
    color: @TEXT_PRIMARY@;
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    font-size: @FONT_SIZE_CAPTION@px;
    padding: 18px 22px;
    qproperty-wordWrap: true;
}

QLabel#partialCaption {
    color: @TEXT_SECONDARY@;
    background-color: @BG_PANEL@;
    border: 1px dashed @BORDER@;
    font-size: 18px;
    padding: 10px 14px;
    qproperty-wordWrap: true;
}

QStatusBar {
    background-color: @BG_SECONDARY@;
    color: @TEXT_SECONDARY@;
    border-top: 1px solid @BORDER@;
    font-size: 13px;
}

QStatusBar QLabel {
    padding: 4px 14px;
    color: @TEXT_SECONDARY@;
}

QStatusBar QLabel[role="ok"] { color: @SUCCESS@; }
QStatusBar QLabel[role="warn"] { color: @WARNING@; }
QStatusBar QLabel[role="err"] { color: @ERROR@; }

QPushButton {
    background-color: @BG_PANEL@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @ACCENT@;
    padding: 8px 18px;
    font-weight: 600;
    letter-spacing: 1px;
}

QPushButton:hover {
    background-color: @ACCENT_DIM@;
    color: @BG_PRIMARY@;
}

QPushButton:pressed {
    background-color: @ACCENT@;
    color: @BG_PRIMARY@;
}
