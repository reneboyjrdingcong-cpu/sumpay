/* Project Sumpay — Clinical Light kiosk theme.
   Color tokens are substituted at runtime from gui/theme.py. */

QMainWindow, QWidget {
    background-color: @BG_PRIMARY@;
    color: @TEXT_PRIMARY@;
    font-family: @FONT_FAMILY@;
    font-size: @FONT_SIZE_BODY@px;
    border: none;
}

QLabel {
    color: @TEXT_PRIMARY@;
    background: transparent;
    border: none;
}

/* ── Paper card surfaces ───────────────────────────────────────────── */

QFrame#glassCard {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 24px;
}

QFrame#glassCardDeep {
    background-color: @BG_GLASS_DEEP@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 24px;
}

/* ── Circle buttons (Confirm / Retry / Edit) ───────────────────────── */

QPushButton#circleBtn {
    background-color: @BG_GLASS_DEEP@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 32px;
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    color: @TEXT_PRIMARY@;
    font-size: @FONT_SIZE_BODY@px;
    font-weight: 500;
}

QPushButton#circleBtn:hover {
    background-color: @BG_GLASS@;
}

QPushButton#circleBtn:pressed {
    background-color: @BORDER_HAIRLINE@;
}

/* ── Confirm / Retry / Edit color variants ─────────────────────────── */

QPushButton#circleBtnConfirm {
    background-color: @ACCENT_PRIMARY@;
    border: none; border-radius: 32px;
    min-width: 64px; min-height: 64px; max-width: 64px; max-height: 64px;
    color: #FFFFFF; font-size: @FONT_SIZE_BODY@px; font-weight: 600;
}
QPushButton#circleBtnConfirm:hover   { background-color: @ACCENT_PRIMARY_HOVER@; }
QPushButton#circleBtnConfirm:pressed { background-color: @ACCENT_PRIMARY_PRESSED@; }

QPushButton#circleBtnRetry {
    background-color: @ACCENT_DANGER@;
    border: none; border-radius: 32px;
    min-width: 64px; min-height: 64px; max-width: 64px; max-height: 64px;
    color: #FFFFFF; font-size: @FONT_SIZE_BODY@px; font-weight: 600;
}
QPushButton#circleBtnRetry:hover   { background-color: @ACCENT_DANGER_HOVER@; }
QPushButton#circleBtnRetry:pressed { background-color: @ACCENT_DANGER_PRESSED@; }

QPushButton#circleBtnEdit {
    background-color: @ACCENT_EDIT@;
    border: none; border-radius: 32px;
    min-width: 64px; min-height: 64px; max-width: 64px; max-height: 64px;
    color: #FFFFFF; font-size: @FONT_SIZE_BODY@px; font-weight: 600;
}
QPushButton#circleBtnEdit:hover   { background-color: @ACCENT_EDIT_HOVER@; }
QPushButton#circleBtnEdit:pressed { background-color: @ACCENT_EDIT_PRESSED@; }

/* ── Status pill (camera screen overlay) ──────────────────────────── */

QWidget#statusPill {
    background-color: @BG_GLASS_DEEP@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 14px;
}

/* ── Confirm screen text card — editing-state hairline ──────────── */

QFrame#glassCardDeep[editing="true"] {
    border: 1px solid @ACCENT_EDIT@;
}

/* ── Video canvas ─────────────────────────────────────────────────── */

QLabel#videoCanvas {
    background-color: @BG_GLASS_DEEP@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 32px;
    color: @TEXT_SECONDARY@;
}

/* ── Editable text area (confirm screen edit mode) ────────────────── */

QTextEdit#editableText {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 24px;
    font-weight: 300;
    selection-background-color: @TEXT_SELECTION@;
}

/* ── Speaker halo button (audio screen) ──────────────────────────── */

QPushButton#speakerButton {
    background: @BG_GLASS@;
    border: 1px solid @BORDER_HAIRLINE@;
    border-radius: 110px;
    font-size: 64px;
    color: @ACCENT_PRIMARY@;
}
QPushButton#speakerButton:hover   { background: @BG_GLASS_DEEP@; }
QPushButton#speakerButton:pressed { background: @BORDER_HAIRLINE@; }

/* ── Scrollbars — nearly invisible ───────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 4px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 40);
    border-radius: 2px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
