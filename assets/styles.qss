/* Project Sumpay — White Mode glassmorphism.
   Color tokens are substituted at runtime from gui/theme.py. */

QMainWindow, QWidget {
    background-color: @BG_PRIMARY@;
    color: @TEXT_PRIMARY@;
    font-family: @FONT_FAMILY@;
    font-size: @FONT_SIZE_BODY@px;
    border: none;
}

QLabel {
    color: @TEXT_PRIMARY@;
    background: transparent;
    border: none;
}

/* ── Glass card surfaces ───────────────────────────────────────────── */

QFrame#glassCard {
    background-color: @BG_GLASS@;
    border: none;
    border-radius: 24px;
}

QFrame#glassCardDeep {
    background-color: @BG_GLASS_DEEP@;
    border: none;
    border-radius: 24px;
}

/* ── Circle buttons (Confirm / Retry / Edit) ───────────────────────── */

QPushButton#circleBtn {
    background-color: @BG_GLASS_DEEP@;
    border: none;
    border-radius: 28px;
    min-width: 56px;
    min-height: 56px;
    max-width: 56px;
    max-height: 56px;
    color: @TEXT_PRIMARY@;
    font-size: @FONT_SIZE_BODY@px;
    font-weight: 500;
}

QPushButton#circleBtn:hover {
    background-color: rgba(232, 232, 237, 230);
}

QPushButton#circleBtn:pressed {
    background-color: rgba(210, 210, 215, 230);
}

/* ── Continue button (camera screen) ──────────────────────────────── */

QPushButton#continueBtn {
    background-color: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: @FONT_SIZE_HINT@px;
    font-weight: 400;
    padding: 6px 12px;
}

QPushButton#continueBtn:hover {
    color: @TEXT_PRIMARY@;
}

/* ── Video canvas ─────────────────────────────────────────────────── */

QLabel#videoCanvas {
    background-color: #F2F2F7;
    border: none;
    border-radius: 32px;
    color: @TEXT_SECONDARY@;
}

/* ── Editable text area (confirm screen edit mode) ────────────────── */

QTextEdit#editableText {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 25px;
    font-weight: 300;
    selection-background-color: rgba(0, 122, 255, 60);
}

/* ── Scrollbars — nearly invisible ───────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 4px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 40);
    border-radius: 2px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
